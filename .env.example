PORT=3000
APP_URL=http://localhost:3000

# REQUIRED: Postgres connection string. Get one from a managed provider
# (Neon, Supabase, Railway, RDS, etc.) for production, or point at a local
# Postgres for development.
DATABASE_URL=postgres://user:password@localhost:5432/loop

# REQUIRED in production: a long random string. Production startup refuses to run without it.
JWT_SECRET=change-this-in-production

OPENAI_API_KEY=
# Any real OpenAI chat model, e.g. gpt-4o-mini, gpt-4.1-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini
# Optional: point at a free OpenAI-compatible provider instead of OpenAI.
# Leave blank to use OpenAI itself. Example for Groq's free tier:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<your Groq key>
#   OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=

# Optional: real email delivery (verification, password reset, reminders).
# Without this, verification/reset links are logged to the server console
# instead of emailed — fine for local dev, not for real users.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=

# If true, users must click the verification link before they can log in.
# Defaults to false so you're not locked out without email configured.
REQUIRE_EMAIL_VERIFICATION=false

# Stripe (use Stripe Dashboard-created recurring monthly Price IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_TEAM=

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/gmail/callback

# WhatsApp Business / Meta
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=https://YOUR_DOMAIN/api/webhooks/whatsapp

# Slack: create an app at api.slack.com/apps, add the OAuth scopes listed
# in server.js, and set the redirect URL to APP_URL + /api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Encrypt OAuth tokens at rest; production startup refuses to run without it
INTEGRATION_ENCRYPTION_KEY=
